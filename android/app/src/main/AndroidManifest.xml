<?xml version="1.0" encoding="utf-8"?>
<!-- Sem backup do sistema: a cópia local da conta tem dados de saúde (SEC-AND-04) -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Treino: notificação do treino em andamento e aviso de fim do descanso (pedido ao começar um treino); lembrete para
         treinar e resumo da semana (pedido ao ligar um deles em Ajustes → Notificações) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Mapa e lugares de treino (SEC-AND-06): a posição só é usada no aparelho para o mapa, a cerca das academias e a
         confirmação de saída; nunca vai para o servidor. Precisa/aproximada pedidas ao abrir o mapa ou cadastrar um lugar. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- "O tempo todo": só para a chegada e a saída da academia com o app fechado, pedida depois de uma explicação e só
         com "Avisar ao chegar" ou "Encerrar treino ao sair" ligado e um lugar salvo (regras do Google Play) -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- A cerca e os alarmes dos lembretes somem ao reiniciar o aparelho: o app só os registra de novo (nenhum outro
         trabalho no boot) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Health Connect: só leitura dos tipos usados (SEC-AND-05). Treinos viram atividades; calorias e distância ficam na
         conta e não vão para posts nem X1; peso vai para Peso e medidas. -->
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />

    <!-- Saber se o Health Connect está instalado (Android 13 ou anterior, onde ele é um app à parte) -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:name=".GymBrosApp"
        android:allowBackup="false"
        android:label="GymBros"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GymBros">
        <activity
            android:name=".MainActivity"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Link de amigo (gymbros://amigo/CÓDIGO): o app sempre pede confirmação antes de adicionar (SEC-AND-01) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="gymbros" android:host="amigo" />
            </intent-filter>
        </activity>
        <!-- Fim do descanso do treino (RestAlarm): só o próprio app dispara -->
        <receiver android:name=".data.train.RestReceiver" android:exported="false" />
        <!-- Botões da notificação do treino em andamento (Série feita, Pular descanso, +1 rodada): só o próprio app dispara -->
        <receiver android:name=".data.train.LiveWorkoutReceiver" android:exported="false" />
        <!-- Entrada e saída da cerca das academias: só o Google Play Services dispara, pelo PendingIntent do app -->
        <receiver android:name=".data.map.GeofenceReceiver" android:exported="false" />
        <!-- Registra a cerca de novo depois de reiniciar ou atualizar (o sistema entrega a receptor não exportado) -->
        <receiver android:name=".data.map.GymBootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- Lembrete para treinar e resumo da semana (LocalReminders): o alarme é do próprio app; reiniciar, atualizar ou
             mudar a hora/fuso refaz a agenda (o sistema entrega a receptor não exportado) -->
        <receiver android:name=".data.reminders.ReminderReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>

        <!-- Foto da câmera em resolução cheia (TakePicture): o app da câmera recebe só a URI de um arquivo em cache/camera/,
             com permissão temporária; não exportado, sem acesso a mais nada -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.camera"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/camera_paths" />
        </provider>

        <!-- Política de privacidade aberta pelo Health Connect ao pedir permissão (Android 13 ou anterior) -->
        <activity
            android:name=".HealthRationaleActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- A mesma tela no Android 14 ou mais novo (Health Connect do sistema); só o sistema pode abrir -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".HealthRationaleActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
