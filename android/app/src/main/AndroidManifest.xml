<?xml version="1.0" encoding="utf-8"?>
<!-- Sem backup do sistema: a cópia local da conta tem dados de saúde (SEC-AND-04) -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Treino: aviso de fim do descanso (pedido ao começar um treino, só com o ajuste ligado) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".GymBrosApp"
        android:allowBackup="false"
        android:label="GymBros"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GymBros">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Link de amigo (gymbros://amigo/CÓDIGO): o app sempre pede confirmação antes de adicionar (SEC-AND-01) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="gymbros" android:host="amigo" />
            </intent-filter>
        </activity>
        <!-- Fim do descanso do treino (RestAlarm): só o próprio app dispara -->
        <receiver android:name=".data.train.RestReceiver" android:exported="false" />
    </application>
</manifest>
