<?xml version="1.0" encoding="utf-8"?>
<!-- Sem backup do sistema: a cópia local da conta tem dados de saúde (SEC-AND-04) -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Treino: aviso de fim do descanso (pedido ao começar um treino, só com o ajuste ligado) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Health Connect: só leitura dos tipos usados (SEC-AND-05). Treinos viram atividades; calorias e distância ficam na
         conta e não vão para posts nem X1; peso vai para Peso e medidas. -->
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />

    <!-- Saber se o Health Connect está instalado (Android 13 ou anterior, onde ele é um app à parte) -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:name=".GymBrosApp"
        android:allowBackup="false"
        android:label="GymBros"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GymBros">
        <activity
            android:name=".MainActivity"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Link de amigo (gymbros://amigo/CÓDIGO): o app sempre pede confirmação antes de adicionar (SEC-AND-01) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="gymbros" android:host="amigo" />
            </intent-filter>
        </activity>
        <!-- Fim do descanso do treino (RestAlarm): só o próprio app dispara -->
        <receiver android:name=".data.train.RestReceiver" android:exported="false" />

        <!-- Política de privacidade aberta pelo Health Connect ao pedir permissão (Android 13 ou anterior) -->
        <activity
            android:name=".HealthRationaleActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- A mesma tela no Android 14 ou mais novo (Health Connect do sistema); só o sistema pode abrir -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".HealthRationaleActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
