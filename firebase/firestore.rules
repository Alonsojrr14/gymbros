rules_version = '2';

// GymBros: só quem está logado lê; cada um só grava e apaga o que é seu (campo `user` = seu uid).
// Mesmo modelo do banco público do CloudKit. Publicar: firebase deploy --only firestore (pasta firebase/).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    // Documento novo ou alterado em seu nome
    function writesAsMe() { return signedIn() && request.resource.data.user == uid(); }
    // Documento que já era seu
    function wasMine() { return signedIn() && resource.data.user == uid(); }
    function doc(c, id) { return /databases/$(database)/documents/$(c)/$(id); }
    // Role ADMIN em roles/{uid} (o primeiro é criado à mão no console)
    function isAdmin() {
      return signedIn() && exists(doc('roles', uid())) && 'ADMIN' in get(doc('roles', uid())).data.roles;
    }
    // `other` adicionou você (amigo, ou pediu amizade) e não te bloqueou
    function reachable(other) {
      return exists(doc('friendLinks', other + '->' + uid())) && !exists(doc('blocks', other + '->' + uid()));
    }
    // Você está nesta liga (o documento de membro é `{liga}-{uid}`)
    function memberOf(league) { return exists(doc('members', league + '-' + uid())); }
    // Amizade dos dois lados
    function friends(other) {
      return exists(doc('friendLinks', uid() + '->' + other)) && exists(doc('friendLinks', other + '->' + uid()));
    }
    // Só estes campos mudaram
    function only(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    // O código de amigo do perfil tem de estar reservado por você (friendCodes): ninguém copia o de outra pessoa
    function codeIsMine() {
      return !('friendCode' in request.resource.data) || request.resource.data.friendCode == ''
        || getAfter(doc('friendCodes', request.resource.data.friendCode)).data.user == uid();
    }

    match /profiles/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn() && id == uid() && codeIsMine();
      allow delete: if signedIn() && id == uid();
      // Admin tira do ar nome, bio e o resto do perfil denunciado
      allow update: if isAdmin() && only(['name', 'username', 'bio', 'public']);
    }

    // "eu->você": só quem pede cria e apaga; só as duas pontas leem
    match /friendLinks/{id} {
      allow read: if signedIn() && (resource.data.from == uid() || resource.data.to == uid());
      allow create, update: if signedIn() && request.resource.data.from == uid()
                            && id == uid() + '->' + request.resource.data.to;
      allow delete: if signedIn() && resource.data.from == uid();
    }

    // Liga: o dono (`owner`) edita as regras e pode passar a liga para outra pessoa
    match /leagues/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.owner == uid() && request.resource.data.code == code;
      allow update: if signedIn() && resource.data.owner == uid();
      allow delete: if false;
    }

    // Membros, check-ins, mural e pedidos de uma liga: só quem está nela lê (menor privilégio). Os seus você sempre lê
    // (sair da liga, excluir a conta); amigos veem em que ligas você está ("ligas em comum").
    match /members/{id} {
      allow read: if signedIn() && (resource.data.user == uid() || memberOf(resource.data.league) || friends(resource.data.user)
                                    || isAdmin());
      allow create: if writesAsMe() && id == request.resource.data.league + '-' + uid();
      allow update: if wasMine() && writesAsMe();
      allow delete: if wasMine();
    }

    // Posts do perfil seguem o perfil público; posts de liga pública no Feed, só para amigos de quem postou
    match /checkIns/{id} {
      allow read: if signedIn() && (resource.data.user == uid() || resource.data.league == 'profile'
                                    || memberOf(resource.data.league)
                                    || (resource.data.feed == true && friends(resource.data.user)) || isAdmin());
      allow create: if writesAsMe();
      allow update: if wasMine() && writesAsMe();
      allow delete: if wasMine() || isAdmin();
    }

    // Comentários e reações nos check-ins: quem vê o post vê todos. Apaga quem escreveu, o dono do post ou a moderação.
    match /comments/{id} {
      allow read: if signedIn();
      allow create: if writesAsMe() && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
        && request.resource.data.item is string && request.resource.data.owner is string;
      allow update: if false;
      allow delete: if wasMine() || isAdmin() || (signedIn() && resource.data.owner == uid());
    }

    match /messages/{id} {
      allow read: if signedIn() && (resource.data.user == uid() || memberOf(resource.data.league) || isAdmin());
      allow create: if writesAsMe() && request.resource.data.text.size() <= 1000;
      allow update: if wasMine() && writesAsMe();
      allow delete: if wasMine() || isAdmin();
    }

    // Pedido de entrada: quem pediu e os membros da liga (o dono decide)
    match /joinRequests/{id} {
      allow read: if signedIn() && (resource.data.user == uid() || memberOf(resource.data.league));
      allow create, update: if writesAsMe() && id == request.resource.data.league + '-pedido-' + uid();
      allow delete: if wasMine();
    }

    // Mensagem direta: só as duas pontas leem; manda quem é você, para alguém que adicionou você (amigo ou
    // quem já tinha te adicionado). Não se edita nem se apaga ("limpar conversa" é só do seu lado).
    match /directMessages/{id} {
      allow read: if signedIn() && uid() in resource.data.participants;
      allow create: if signedIn()
                    && request.resource.data.from == uid()
                    && request.resource.data.to != uid()
                    && request.resource.data.participants == [uid(), request.resource.data.to]
                    && request.resource.data.text is string && request.resource.data.text.size() <= 2000
                    && reachable(request.resource.data.to);
      allow update: if false;
      allow delete: if isAdmin();
    }

    // X1: quem desafia cria (só amigo que não te bloqueou); o desafiado responde uma vez; cada lado só escreve o próprio valor.
    // Datas do servidor: ninguém adianta nem atrasa o relógio do X1.
    match /duels/{id} {
      allow read: if signedIn() && uid() in resource.data.participants;
      allow create: if signedIn()
                    && request.resource.data.challenger == uid()
                    && request.resource.data.challenged != uid()
                    && request.resource.data.participants == [uid(), request.resource.data.challenged]
                    && request.resource.data.createdAt == request.time
                    && !('answer' in request.resource.data)
                    && reachable(request.resource.data.challenged);
      allow update: if signedIn() && (
                      (uid() == resource.data.challenged && !('answer' in resource.data)
                        && only(['answer', 'answeredAt', 'challengedFormID'])
                        && request.resource.data.answer in ['accepted', 'declined']
                        && request.resource.data.answeredAt == request.time
                        && request.time < resource.data.createdAt + duration.value(24, 'h'))
                      || (uid() in resource.data.participants && only(['score_' + uid()])
                        && request.resource.data['score_' + uid()] is int));
      allow delete: if false;
    }

    // Trocas: quem propõe cria; o outro aceita ou recusa em até 48 h; quem propôs pode cancelar antes da resposta
    match /trades/{id} {
      allow read: if signedIn() && uid() in resource.data.participants;
      allow create: if signedIn()
                    && request.resource.data.from == uid()
                    && request.resource.data.to != uid()
                    && request.resource.data.participants == [uid(), request.resource.data.to]
                    && request.resource.data.createdAt == request.time
                    && !('answer' in request.resource.data)
                    && reachable(request.resource.data.to);
      allow update: if signedIn() && !('answer' in resource.data)
                    && only(['answer', 'answeredAt']) && request.resource.data.answeredAt == request.time
                    && ((uid() == resource.data.to && request.resource.data.answer in ['accepted', 'declined']
                          && request.time < resource.data.createdAt + duration.value(48, 'h'))
                        || (uid() == resource.data.from && request.resource.data.answer == 'canceled'));
      allow delete: if false;
    }

    // Bros que cada um pode trocar: lê quem a pessoa adicionou
    match /tradeBros/{id} {
      allow get: if signedIn() && (id == uid() || exists(doc('friendLinks', id + '->' + uid())));
      allow write: if signedIn() && id == uid() && request.resource.data.user == uid();
      allow delete: if signedIn() && id == uid();
    }

    // Denúncias: você cria e troca o motivo das suas; só admin lê e resolve
    match /reports/{id} {
      allow create, update: if writesAsMe() && id.matches(uid() + '-.*') && request.resource.data.date == request.time;
      allow read: if isAdmin();
      // Excluir a conta busca as suas denúncias para apagar (sem isso a consulta é recusada e a exclusão inteira falha)
      allow list: if wasMine();
      allow delete: if wasMine() || isAdmin();
    }

    // Bloqueios: cada um vê e mexe só nos seus; as regras de mensagem, X1 e troca leem o do outro lado
    match /blocks/{id} {
      allow read: if wasMine();
      allow create, update: if writesAsMe() && id == uid() + '->' + request.resource.data.blocked;
      allow delete: if wasMine();
    }

    // Roles: você lê as suas; só admin dá roles, e nunca para si mesmo
    match /roles/{id} {
      allow get: if signedIn() && (id == uid() || isAdmin());
      allow write: if isAdmin() && id != uid();
    }

    // Rotinas públicas: o autor edita e apaga; os outros só curtem e contam cópias, de 1 em 1
    match /routines/{id} {
      allow read: if signedIn();
      allow create: if writesAsMe() && request.resource.data.likes == 0 && request.resource.data.saves == 0
                    && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && (
                      (wasMine() && writesAsMe() && request.resource.data.likes == resource.data.likes
                        && request.resource.data.saves == resource.data.saves && request.resource.data.createdAt == resource.data.createdAt)
                      || (only(['likes']) && (request.resource.data.likes == resource.data.likes + 1
                                             || request.resource.data.likes == resource.data.likes - 1))
                      || (only(['saves']) && request.resource.data.saves == resource.data.saves + 1));
      allow delete: if wasMine() || isAdmin();
    }

    // Cópia da conta: só o dono
    match /accounts/{id} {
      allow read, write: if signedIn() && id == uid();
      match /chunks/{n} {
        allow read, write: if signedIn() && id == uid();
      }
    }

    // Foto do perfil (pequena, redimensionada no aparelho): quem tem conta vê, como nome e bio; só o dono publica;
    // o dono ou um admin (moderação) tiram do ar
    match /avatars/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn() && id == uid()
                            && request.resource.data.keys().hasOnly(['data', 'updatedAt'])
                            && request.resource.data.data is bytes && request.resource.data.data.size() < 150000;
      allow delete: if signedIn() && (id == uid() || isAdmin());
    }

    // Código de amigo: o primeiro a reservar fica com ele; não se troca de dono nem se lista
    match /friendCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.user == uid() && code.matches('^[A-HJ-NP-Z2-9]{6}$');
      allow delete: if signedIn() && resource.data.user == uid();
    }

    // Treino ao vivo: um documento por pessoa; lê só amigo de verdade (os dois se adicionaram). Só a ida
    // ("ela me adicionou") deixava qualquer link de amigo aberto sem querer liberar a localização ao vivo.
    match /live/{id} {
      allow get: if signedIn() && (id == uid()
                  || (exists(doc('friendLinks', id + '->' + uid())) && exists(doc('friendLinks', uid() + '->' + id))
                      && !exists(doc('blocks', id + '->' + uid()))));
      allow list: if false;
      allow create, update: if signedIn() && id == uid() && request.resource.data.user == uid();
      // Excluir a conta apaga o seu (na exclusão não há request.resource, então o write acima recusaria)
      allow delete: if signedIn() && id == uid();
    }
  }
}
